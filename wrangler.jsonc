{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rec",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "web",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    // banco D1 "rec" (o ID não é segredo)
    { "binding": "DB", "database_name": "rec", "database_id": "dc1a8113-cc1a-4434-9eaf-1dac6bf730aa" }
  ],
  // a cada 15 min das 04:00 às 10:45 de Brasília (UTC−3); para de chamar a Garmin quando a noite chega
  "triggers": { "crons": ["*/15 7-13 * * *"] },
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "observability": { "enabled": true }
}
