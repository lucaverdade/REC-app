{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rec",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "web",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    // database_id: preencher depois de `npx wrangler d1 create rec`
    { "binding": "DB", "database_name": "rec", "database_id": "00000000-0000-0000-0000-000000000000" }
  ],
  // a cada 15 min das 04:00 às 10:45 de Brasília (UTC−3); para de chamar a Garmin quando a noite chega
  "triggers": { "crons": ["*/15 7-13 * * *"] },
  "observability": { "enabled": true }
}
