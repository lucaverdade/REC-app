{
  "name": "rec-app",
  "private": true,
  "type": "module",
  "scripts": {
    "ref": "python3 scripts/dump_reference.py data/daily_metrics.csv",
    "test": "node test/rec.parity.test.ts && node test/zones.test.ts",
    "typecheck": "tsc -p .",
    "seed": "node scripts/seed.ts",
    "db:schema:local": "wrangler d1 execute rec --local --file worker/schema.sql",
    "db:seed:local": "wrangler d1 execute rec --local --file data/seed.sql",
    "db:schema:remote": "wrangler d1 execute rec --remote --file worker/schema.sql",
    "db:seed:remote": "wrangler d1 execute rec --remote --file data/seed.sql",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "mock:garmin": "node test/mock-garmin.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261103.1",
    "@garmin/fitsdk": "^21.221.0",
    "fflate": "^0.8.3",
    "typescript": "^7.0.2",
    "wrangler": "^4.157.0"
  }
}
